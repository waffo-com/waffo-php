{
  "module": "webhook-verify",
  "version": "1.0.0",
  "description": "Test vectors for webhook signature verification and event handling",
  "algorithm": {
    "name": "SHA256withRSA",
    "signatureHeader": "X-SIGNATURE",
    "responseSignatureRequired": true
  },
  "testKeys": {
    "description": "Temporary keys for simulating Waffo webhook signatures in tests",
    "note": "Generate a new key pair for each test to simulate Waffo signing",
    "privateKey": "",
    "publicKey": ""
  },
  "eventTypes": [
    {
      "type": "PAYMENT_NOTIFICATION",
      "description": "Payment status notification",
      "payloadFields": ["acquiringOrderId", "paymentRequestId", "orderStatus", "paidAmount", "paidCurrency", "paidTime"]
    },
    {
      "type": "REFUND_NOTIFICATION",
      "description": "Refund status notification",
      "payloadFields": ["acquiringOrderId", "refundRequestId", "refundStatus", "refundAmount", "refundCurrency"]
    },
    {
      "type": "SUBSCRIPTION_STATUS_NOTIFICATION",
      "description": "Subscription status change",
      "payloadFields": ["subscriptionId", "subscriptionStatus", "previousStatus"]
    },
    {
      "type": "SUBSCRIPTION_PERIOD_CHANGED_NOTIFICATION",
      "description": "Subscription period change",
      "payloadFields": ["subscriptionId", "newPeriodStart", "newPeriodEnd", "billingCycleNumber"]
    },
    {
      "type": "SUBSCRIPTION_CHANGE_NOTIFICATION",
      "description": "Subscription change (upgrade/downgrade) result",
      "payloadFields": ["subscriptionRequest", "originSubscriptionRequest", "subscriptionChangeStatus", "subscriptionAction", "remainingAmount"]
    }
  ],
  "unitTests": [
    {
      "id": "WHK-001",
      "name": "verify_payment_notification",
      "description": "Verify valid payment notification webhook",
      "input": {
        "payload": {
          "acquiringOrderId": "ACQ_123456",
          "paymentRequestId": "PAY_REQ_001",
          "orderStatus": "PAY_SUCCESS",
          "paidAmount": "100.00",
          "paidCurrency": "HKD",
          "paidTime": "2024-01-15T10:30:00Z"
        },
        "signatureHeader": "X-SIGNATURE"
      },
      "expected": {
        "valid": true,
        "eventType": "PAYMENT_NOTIFICATION"
      },
      "note": "Sign payload with testKeys.privateKey, set signature in X-SIGNATURE header"
    },
    {
      "id": "WHK-002",
      "name": "verify_refund_notification",
      "description": "Verify valid refund notification webhook",
      "input": {
        "payload": {
          "acquiringOrderId": "ACQ_123456",
          "refundRequestId": "REF_001",
          "refundStatus": "REFUND_SUCCESS",
          "refundAmount": "50.00",
          "refundCurrency": "HKD"
        }
      },
      "expected": {
        "valid": true,
        "eventType": "REFUND_NOTIFICATION"
      }
    },
    {
      "id": "WHK-003",
      "name": "verify_subscription_status_notification",
      "description": "Verify subscription status change notification",
      "input": {
        "payload": {
          "subscriptionId": "SUB_123",
          "subscriptionStatus": "ACTIVE",
          "previousStatus": "IN_PROGRESS"
        }
      },
      "expected": {
        "valid": true,
        "eventType": "SUBSCRIPTION_STATUS_NOTIFICATION"
      }
    },
    {
      "id": "WHK-004",
      "name": "verify_subscription_status_fallback_to_payment_handler",
      "description": "SUBSCRIPTION_STATUS_NOTIFICATION should fallback to onSubscriptionPayment handler when onSubscriptionStatus is not registered",
      "input": {
        "payload": {
          "subscriptionId": "SUB_123",
          "subscriptionStatus": "ACTIVE",
          "previousStatus": "IN_PROGRESS"
        }
      },
      "expected": {
        "valid": true,
        "eventType": "SUBSCRIPTION_STATUS_NOTIFICATION",
        "handlerFallback": "onSubscriptionPayment"
      },
      "note": "There is no SUBSCRIPTION_PAYMENT_NOTIFICATION event. onSubscriptionPayment is a fallback for SUBSCRIPTION_STATUS_NOTIFICATION when onSubscriptionStatus is not registered."
    },
    {
      "id": "WHK-005",
      "name": "verify_subscription_period_changed",
      "description": "Verify subscription period change notification",
      "input": {
        "payload": {
          "subscriptionId": "SUB_123",
          "newPeriodStart": "2024-02-01T00:00:00Z",
          "newPeriodEnd": "2024-03-01T00:00:00Z",
          "billingCycleNumber": 2
        }
      },
      "expected": {
        "valid": true,
        "eventType": "SUBSCRIPTION_PERIOD_CHANGED_NOTIFICATION"
      }
    },
    {
      "id": "WHK-006",
      "name": "verify_subscription_change_notification",
      "description": "Verify subscription change result notification",
      "input": {
        "payload": {
          "subscriptionRequest": "new-sub-req-001",
          "originSubscriptionRequest": "orig-sub-req-001",
          "subscriptionChangeStatus": "SUCCESS",
          "subscriptionAction": "UPGRADE",
          "remainingAmount": "50.00"
        }
      },
      "expected": {
        "valid": true,
        "eventType": "SUBSCRIPTION_CHANGE_NOTIFICATION"
      }
    }
  ],
  "edgeCases": [
    {
      "id": "WHK-E01",
      "name": "invalid_signature",
      "description": "Reject invalid signature",
      "input": {
        "payload": { "acquiringOrderId": "ACQ_123" },
        "signature": "INVALID_SIGNATURE_BASE64"
      },
      "expected": {
        "valid": false,
        "error": "Signature verification failed"
      }
    },
    {
      "id": "WHK-E02",
      "name": "missing_signature",
      "description": "Reject missing signature header",
      "input": {
        "payload": { "acquiringOrderId": "ACQ_123" },
        "signature": null
      },
      "expected": {
        "valid": false,
        "error": "Missing X-SIGNATURE header"
      }
    },
    {
      "id": "WHK-E03",
      "name": "empty_signature",
      "description": "Reject empty signature",
      "input": {
        "payload": { "acquiringOrderId": "ACQ_123" },
        "signature": ""
      },
      "expected": {
        "valid": false,
        "error": "Empty X-SIGNATURE header"
      }
    },
    {
      "id": "WHK-E04",
      "name": "tampered_payload",
      "description": "Reject tampered payload",
      "input": {
        "originalPayload": { "acquiringOrderId": "ACQ_123", "amount": "100.00" },
        "tamperedPayload": { "acquiringOrderId": "ACQ_123", "amount": "1000.00" },
        "signatureOfOriginal": "GENERATED_FROM_ORIGINAL"
      },
      "expected": {
        "valid": false,
        "error": "Signature verification failed"
      }
    },
    {
      "id": "WHK-E05",
      "name": "malformed_json",
      "description": "Reject malformed JSON payload",
      "input": {
        "rawPayload": "{invalid json",
        "signature": "SOME_SIGNATURE"
      },
      "expected": {
        "valid": false,
        "error": "Invalid JSON payload"
      }
    },
    {
      "id": "WHK-E06",
      "name": "unicode_payload",
      "description": "Handle Unicode in payload correctly",
      "input": {
        "payload": {
          "orderDescription": "测试订单 - Test Order",
          "userName": "張三"
        }
      },
      "expected": {
        "valid": true
      },
      "note": "Ensure UTF-8 encoding when verifying signature"
    }
  ],
  "responseSignature": {
    "description": "Webhook handlers must return signed responses",
    "format": {
      "body": "{\"message\":\"success\"}",
      "signatureHeader": "X-SIGNATURE"
    },
    "tests": [
      {
        "id": "WHK-R01",
        "name": "response_signature_required",
        "description": "Response must include X-SIGNATURE header",
        "input": {
          "responseBody": "{\"message\":\"success\"}"
        },
        "expected": {
          "hasSignature": true,
          "signatureValid": true
        }
      }
    ]
  },
  "handlerChainTests": [
    {
      "id": "WHK-H01",
      "name": "chainable_handlers",
      "description": "Handler registration should be chainable",
      "code": "waffo.webhook().onPayment(handler1).onRefund(handler2).onSubscriptionStatus(handler3)"
    },
    {
      "id": "WHK-H02",
      "name": "handler_receives_typed_notification",
      "description": "Each handler receives correctly typed notification object",
      "expected": {
        "onPayment": "PaymentNotification",
        "onRefund": "RefundNotification",
        "onSubscriptionStatus": "SubscriptionStatusNotification",
        "onSubscriptionPayment": "SubscriptionStatusNotification",
        "onSubscriptionPeriodChanged": "SubscriptionPeriodChangedNotification"
      }
    }
  ],
  "implementation": {
    "webhookProcessingFlow": [
      "1. Receive POST request with JSON body and X-SIGNATURE header",
      "2. Extract raw body bytes (preserve exact encoding)",
      "3. Extract X-SIGNATURE header value",
      "4. Verify signature using Waffo public key",
      "5. If valid, parse JSON and determine event type",
      "6. Invoke appropriate registered handler",
      "7. Generate response body",
      "8. Sign response with merchant private key",
      "9. Return response with X-SIGNATURE header"
    ],
    "testSetup": [
      "1. Generate temporary key pair (simulating Waffo keys)",
      "2. Configure SDK with temporary PUBLIC key as waffoPublicKey",
      "3. Sign test payloads with temporary PRIVATE key",
      "4. This simulates Waffo signing webhooks"
    ]
  }
}
