  "edgeCases": [
    {
      "id": "MID-E04",
      "name": "preserve_other_merchantInfo_fields",
      "description": "Preserve other fields in merchantInfo when injecting",
      "input": {
        "configMerchantId": "CONFIG_MERCHANT_123",
        "request": {
          "merchantInfo": {
            "merchantName": "Test Store",
            "mcc": "5411"
          }
        }
      },
      "expected": {
        "request": {
          "merchantInfo": {
            "merchantId": "CONFIG_MERCHANT_123",
            "merchantName": "Test Store",
            "mcc": "5411"
          }
        }
      }
    }
  ],
  "implementation": {
    "injectionLogic": [
      "1. Check if request has merchantInfo or merchantId at target path",
      "2. If target field is null/undefined, check config.merchantId",
      "3. If config.merchantId is non-empty, inject into request",
      "4. Return modified request for API call"
    ],
    "notes": [
      "Injection happens before request signing",
      "Different operations have different injection paths, including no injection",
      "Public resource tests must assert the serialized request body through a fake transport"
    ]
  }
