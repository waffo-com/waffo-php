{
  "module": "merchantid-injection",
  "version": "1.0.0",
  "description": "Test vectors for automatic merchant ID injection",
  "injectionBehavior": {
    "description": "SDK should auto-inject merchantId from config only at the path declared by the operation request schema",
    "sources": [
      "config.merchantId (if configured)",
      "request.merchantInfo.merchantId (if set)",
      "request.merchantId (if set at top level)"
    ],
    "priority": "Request value takes precedence over config value"
  },
  "unitTests": [
    {
      "id": "MID-001",
      "name": "inject_from_config",
      "description": "Inject merchantId from config when not in request",
      "input": {
        "configMerchantId": "CONFIG_MERCHANT_123",
        "requestMerchantId": null
      },
      "expected": {
        "finalMerchantId": "CONFIG_MERCHANT_123"
      }
    },
    {
      "id": "MID-002",
      "name": "preserve_request_value",
      "description": "Keep merchantId from request when set",
      "input": {
        "configMerchantId": "CONFIG_MERCHANT_123",
        "requestMerchantId": "REQUEST_MERCHANT_456"
      },
      "expected": {
        "finalMerchantId": "REQUEST_MERCHANT_456"
      }
    },
    {
      "id": "MID-003",
      "name": "inject_into_merchantInfo",
      "description": "Inject into nested merchantInfo object",
      "input": {
        "configMerchantId": "CONFIG_MERCHANT_123",
        "request": {
          "merchantInfo": {}
        }
      },
      "expected": {
        "request": {
          "merchantInfo": {
            "merchantId": "CONFIG_MERCHANT_123"
          }
        }
      }
    },
    {
      "id": "MID-004",
      "name": "inject_create_merchantInfo",
      "description": "Create merchantInfo object if not exists",
      "input": {
        "configMerchantId": "CONFIG_MERCHANT_123",
        "request": {}
      },
      "expected": {
        "request": {
          "merchantInfo": {
            "merchantId": "CONFIG_MERCHANT_123"
          }
        }
      }
    },
    {
      "id": "MID-005",
      "name": "preserve_nested_merchantInfo",
      "description": "Keep existing merchantInfo.merchantId",
      "input": {
        "configMerchantId": "CONFIG_MERCHANT_123",
        "request": {
          "merchantInfo": {
            "merchantId": "EXISTING_MERCHANT_789"
          }
        }
      },
      "expected": {
        "request": {
          "merchantInfo": {
            "merchantId": "EXISTING_MERCHANT_789"
          }
        }
      }
    },
    {
      "id": "MID-006",
      "name": "inject_top_level",
      "description": "Inject into top-level merchantId",
      "input": {
        "configMerchantId": "CONFIG_MERCHANT_123",
        "request": {
          "merchantId": null
        }
      },
      "expected": {
        "request": {
          "merchantId": "CONFIG_MERCHANT_123"
        }
      }
    }
  ],
